{
  "name": "qingzhou",
  "private": true,
  "version": "0.1.29",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @qingzhou/protocol build && pnpm --parallel --filter @qingzhou/server --filter @qingzhou/web dev",
    "dev:stable": "pnpm --filter @qingzhou/protocol build && pnpm --parallel --filter @qingzhou/server --filter @qingzhou/web dev:stable",
    "typecheck": "pnpm --filter @qingzhou/protocol build && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @qingzhou/protocol build && pnpm --filter @qingzhou/web build && pnpm --filter @qingzhou/server build",
    "start": "node apps/server/dist/index.js",
    "doctor": "tsx scripts/doctor.ts",
    "desktop:dev": "pnpm build && pnpm --filter @qingzhou/desktop tauri:dev",
    "desktop:pack:tauri": "pnpm build && pnpm --filter @qingzhou/desktop tauri:pack",
    "desktop:pack": "pnpm desktop:pack:tauri",
    "desktop:pack:mac": "pnpm desktop:pack:tauri native darwin",
    "desktop:pack:mac:arm64": "pnpm desktop:pack:tauri arm64 darwin",
    "desktop:pack:mac:x64": "pnpm desktop:pack:tauri x64 darwin",
    "desktop:pack:win": "pnpm desktop:pack:tauri x64 win32",
    "desktop:install:mac": "bash scripts/install-macos.sh",
    "desktop:install:win": "pwsh -File scripts/install-windows.ps1",
    "smoke:real": "tsx scripts/smoke-real.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.17.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
