{
  "name": "@qingzhou/desktop",
  "version": "0.1.20",
  "description": "Local-first 轻舟 / Qingzhou workbench for macOS (arm64/x64) and Windows",
  "author": "Qingzhou",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/bundle.mjs && electron .",
    "pack": "pnpm build && electron-builder --config electron-builder.yml",
    "pack:mac": "pnpm build && electron-builder --config electron-builder.yml --mac",
    "pack:mac:arm64": "pnpm build && electron-builder --config electron-builder.yml --mac --arm64",
    "pack:mac:x64": "pnpm build && electron-builder --config electron-builder.yml --mac --x64",
    "pack:win": "pnpm build && electron-builder --config electron-builder.yml --win",
    "pack:dir": "pnpm build && electron-builder --config electron-builder.yml --dir"
  },
  "dependencies": {
    "@qingzhou/server": "workspace:*",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.8",
    "typescript": "^5.9.2"
  }
}
