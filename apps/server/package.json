{
  "name": "@qingzhou/server",
  "version": "0.1.20",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "QINGZHOU_DEV_WATCH=1 tsx watch --exclude '../../packages/protocol/dist/**' src/index.ts",
    "dev:stable": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-extension.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "@qingzhou/protocol": "workspace:*",
    "fastify": "^5.12.1",
    "node-pty": "^1.1.0",
    "thread-stream": "^4.2.0",
    "undici": "^8.10.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
